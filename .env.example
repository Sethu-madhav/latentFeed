# Postgres 17 + pgvector. Create with:
#   createdb latent_feed && psql -d latent_feed -c 'CREATE EXTENSION IF NOT EXISTS vector;'
DATABASE_URL=postgresql://localhost:5432/latent_feed

# Sent on every outbound feed request. Publishers block generic/absent agents,
# and Reddit in particular 429s anything that looks like a bot farm.
INGEST_USER_AGENT=latentFeed/0.1 (+https://github.com/yourname/latentFeed)

# Poll schedule for the worker. Default is every 30 minutes.
POLL_CRON=*/30 * * * *

# Health endpoint port for the worker process.
WORKER_PORT=8788

# Set to 1 to stop the worker polling entirely (the web app still serves).
DISABLE_INGEST=

# --- OpenAI (optional) -------------------------------------------------------
# Everything below is optional. With no key the app runs exactly as it did in
# Sections 1-2: heuristic enrichment and title-similarity dedup.
OPENAI_API_KEY=

# Chat model for the enrichment pass. The mini/nano tier carries the larger
# free daily allowance when traffic is shared with OpenAI.
OPENAI_ENRICHMENT_MODEL=gpt-5.4-mini

# Must be a 1536-dimension model — that is what articles.embedding is declared
# as. Changing this makes existing vectors incomparable; re-run embed:backfill.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# How often the worker upgrades a batch of heuristic rows.
ENRICH_CRON=*/10 * * * *

# Story clustering, offset from the poll schedule so it sees fresh items.
# Needs no API key — falls back to headline overlap without embeddings.
CLUSTER_CRON=5,35 * * * *

# Articles per enrichment cycle — the main cost dial.
ENRICH_BATCH_SIZE=40

# Set either to 1 to switch that half off while keeping the other.
DISABLE_LLM=
DISABLE_EMBEDDINGS=

# --- Auth ---------------------------------------------------------------------
# Signs the session JWT. Required — the app will not start without it.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google sign-in. Optional: leave blank and email/password still works, which
# is usually what you want locally. Create the client at
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application), and register both redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated emails that always get the admin role — the only accounts
# that can add, edit, hide or delete sources. Deleting a source cascades to its
# articles, so this is a destructive capability, not a preference.
#
# Leave blank and the *first* account created becomes admin, so a fresh deploy
# is never left with nobody able to manage sources.
ADMIN_EMAILS=
